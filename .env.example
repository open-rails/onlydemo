# Copy to .env (gitignored). task run loads it; plain go run reads exported envs.
PORT=3000
PUBLIC_URL=http://localhost:3000
# One connection initializes and runs the app, libraries and shared workers.
DATABASE_URL=postgres://postgres:postgres@localhost:55433/openrails_demo?sslmode=disable
APP_SCHEMA=demo
AUTH_SCHEMA=profiles
BILLING_SCHEMA=billing
RIVER_SCHEMA=public
# Leave blank for an auth/blog-only demo; use test credentials to enable sales.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
# Start task stripe:listen, then copy its whsec_ value here before task run.
STRIPE_WEBHOOK_SECRET=
