# Copy to .env (gitignored). Both task run and plain go run load it; exported
# environment variables take precedence.
PORT=3000
PUBLIC_URL=http://localhost:3000
# Extra origins checkout/portal return URLs may name besides PUBLIC_URL.
RETURN_ORIGINS=http://localhost:3000,http://localhost:5173
# One connection initializes and runs the app, libraries and shared workers.
DATABASE_URL=postgres://postgres:postgres@localhost:55433/onlydemo?sslmode=disable
APP_SCHEMA=demo
AUTH_SCHEMA=profiles
BILLING_SCHEMA=billing
RIVER_SCHEMA=public
# Enabled PSP keys; each reads <KEY>_ACCOUNT_ID and its rail's secrets/settings.
BILLING_PSPS=stripe
# With several PSPs, the one taking new purchases and cards.
# BILLING_CHECKOUT_PSP=stripe
# Edge header carrying the buyer's country, e.g. CF-IPCountry (unset: ignored).
# TRUSTED_COUNTRY_HEADER=
# Stripe test credentials. Start task stripe:listen and copy its whsec_ value.
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
# Same account; pk_test_ only. Enables in-page card setup.
STRIPE_PUBLISHABLE_KEY=

# NMI gateway ID and test-mode credentials (when BILLING_PSPS includes nmi).
NMI_ACCOUNT_ID=
NMI_SECURITY_KEY=
NMI_WEBHOOK_SIGNING_SECRET=
# Collect.js browser tokenization; the URL defaults to NMI's standard script.
NMI_TOKENIZATION_KEY=
NMI_TOKENIZATION_URL=
NMI_ENDPOINT_DEPLOYMENT=gateway

# Renewal period of membership prices set afterwards; whole hours (1h tests rebilling).
MEMBERSHIP_PERIOD=720h

# Deleting a paid post: refund, review (merchant decides) or none, for purchases
# made within the window before deletion.
POST_DELETION_REFUND=refund
POST_DELETION_REFUND_WINDOW=720h

# ContentKit schema (the media upload limiter's counters).
CONTENT_SCHEMA=content

# Media: private MinIO bucket from task dev:up, served by task media:access.
MEDIA_S3_ENDPOINT=http://localhost:59000
MEDIA_S3_BUCKET=onlydemo-media
MEDIA_S3_ACCESS_KEY_ID=onlydemo
MEDIA_S3_SECRET_ACCESS_KEY=onlydemo-dev-secret
MEDIA_URL=http://localhost:8090
# URL tokens locally; production uses cookie with MEDIA_COOKIE_DOMAIN set to
# the registrable domain shared by the site and its media host.
MEDIA_DELIVERY=url
MEDIA_COOKIE_DOMAIN=
# Shared with media-access. Generate: echo "dev:$(openssl rand -base64 32)"
MEDIA_TOKEN_KEY=
# Per-uploader rate limits and per-channel storage quota; site admins are exempt.
MEDIA_UPLOAD_FILES_PER_HOUR=60
MEDIA_UPLOAD_BYTES_PER_DAY=107374182400
MEDIA_CHANNEL_QUOTA_BYTES=536870912000
# temp/ retention (Go durations; empty keeps the defaults): unreferenced staged
# uploads 48h, editor views 168h, and the sweep pass interval 24h.
MEDIA_TEMP_UPLOAD_TTL=
MEDIA_EDITOR_TTL=
MEDIA_SWEEP_INTERVAL=
# task media:access: exactly the site origins hls.js reads media from (no wildcards),
# and the Host names media-access answers. Production: https://<domain> and media.<domain>.
MEDIA_ACCESS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MEDIA_ACCESS_HOSTS=localhost,127.0.0.1
# task media:worker ffmpeg threads (default 2).
MEDIA_WORKER_THREADS=2
