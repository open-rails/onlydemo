# Copy to .env (gitignored). task run loads it; plain go run reads exported envs.
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:55433/openrails_demo?sslmode=disable
BILLING_DATABASE_URL=postgres://openrails_demo_billing:local-demo-billing@localhost:55433/openrails_demo?sslmode=disable
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_ACCOUNT_ID=acct_replace_me
# Start task stripe:listen, then copy its whsec_ value here before task run.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Generate once: openssl rand -base64 32. Keep stable across restarts.
BILLING_ENCRYPTION_KEY=replace_with_base64_encoded_32_bytes
