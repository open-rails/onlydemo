# Copy to .env (gitignored). Both task run and plain go run load it; exported
# environment variables take precedence.
PORT=3000
PUBLIC_URL=http://localhost:3000
# Extra origins checkout/portal return URLs may name besides PUBLIC_URL.
RETURN_ORIGINS=http://localhost:3000,http://localhost:5173
# One connection initializes and runs the app, libraries and shared workers.
DATABASE_URL=postgres://postgres:postgres@localhost:55433/onlydemo?sslmode=disable
APP_SCHEMA=demo
AUTH_SCHEMA=profiles
BILLING_SCHEMA=billing
RIVER_SCHEMA=public
# The seller and its PSPs: merchant.yaml (copy merchant.example.yaml).
# MERCHANT_FILE=merchant.yaml
# Edge header carrying the buyer's country, e.g. CF-IPCountry (unset: ignored).
# TRUSTED_COUNTRY_HEADER=
# task stripe:listen: the Stripe test key and account from merchant.yaml.
# STRIPE_SECRET_KEY=
# STRIPE_ACCOUNT_ID=

# ContentKit's schema (its media worker queue is CONTENT_SCHEMA_media_worker).
CONTENT_SCHEMA=contentkit

# Media: private MinIO bucket from task dev:up, served by task media:gateway.
MEDIA_S3_ENDPOINT=http://localhost:59000
MEDIA_S3_BUCKET=onlydemo-media
MEDIA_S3_ACCESS_KEY_ID=onlydemo
MEDIA_S3_SECRET_ACCESS_KEY=onlydemo-dev-secret
MEDIA_URL=http://localhost:8090
# URL tokens locally; production uses cookie with MEDIA_COOKIE_DOMAIN set to
# the registrable domain shared by the site and its media host.
MEDIA_DELIVERY=url
MEDIA_COOKIE_DOMAIN=
# Shared with media-gateway. Generate: echo "dev:$(openssl rand -base64 32)"
MEDIA_TOKEN_KEY=
# task media:gateway: exactly the site origins hls.js reads media from (no wildcards),
# and each media host with the namespace it serves. Production: https://<domain> and media.<domain>=onlydemo.
MEDIA_GATEWAY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MEDIA_GATEWAY_HOSTS=localhost=onlydemo; 127.0.0.1=onlydemo
# task media:worker ffmpeg threads (default 2).
MEDIA_WORKER_THREADS=2
