# Copy to .env (gitignored). Both task run and plain go run load it; exported
# environment variables take precedence.
PORT=3000
PUBLIC_URL=http://localhost:3000
# One connection initializes and runs the app, libraries and shared workers.
DATABASE_URL=postgres://postgres:postgres@localhost:55433/onlydemo?sslmode=disable
APP_SCHEMA=demo
AUTH_SCHEMA=profiles
BILLING_SCHEMA=billing
RIVER_SCHEMA=public
# Enabled providers: stripe, nmi, or stripe,nmi. Each listed one needs its credentials.
BILLING_PSPS=stripe
# Stripe test credentials and the local listener signing secret.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
# Start task stripe:listen, then copy its whsec_ value here before task run.
STRIPE_WEBHOOK_SECRET=

# Same Stripe sandbox account; only pk_test_ is exposed to the browser.
STRIPE_PUBLISHABLE_KEY=

# NMI gateway ID and test-mode credentials (only when BILLING_PSPS includes nmi).
NMI_ACCOUNT_ID=
NMI_SANDBOX_SECURITY_KEY=
NMI_WEBHOOK_SIGNING_SECRET=
# Collect.js browser tokenization; the URL defaults to NMI's standard script.
NMI_TOKENIZATION_KEY=
NMI_TOKENIZATION_URL=
